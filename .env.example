# Copy to .env.local. Never commit real values.
# Frontend-only mode: serve every /api call from the in-browser mock (src/mocks)
NEXT_PUBLIC_USE_MOCKS=1
# Show demo account buttons on the login page
NEXT_PUBLIC_DEMO_HINTS=1

# Backend (Dev A)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=
